{
  "name": "gyopo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p benzi/tsconfig.app.json && vite build && vite build --config benzi/vite.config.ts",
    "build:pages": "tsc -b && tsc -p benzi/tsconfig.app.json && vite build --mode pages && vite build --config benzi/vite.config.ts --mode pages",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "dev:benzi": "vite --config benzi/vite.config.ts"
  },
  "dependencies": {
    "@vite-pwa/assets-generator": "^1.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
